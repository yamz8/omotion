pkgname=omotion
pkgver=0.2.0
pkgrel=1
pkgdesc='Cut a picture into layers and animate it'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'ffmpeg')
makedepends=('gcc' 'make' 'onnxruntime-cpu')
optdepends=('onnxruntime-cpu: AI depth layers and AI select')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omotion "$pkgdir/usr/bin/omotion"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omotion.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omotion.svg"
  install -Dm644 "$startdir/omotion.desktop" "$pkgdir/usr/share/applications/omotion.desktop"
}
