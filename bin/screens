#!/bin/sh
set -eu

# Writes the window's screenshot set to build/screens: wide, tiled tabs,
# Arabic, the shortcuts, the note editor, and the welcome. For looking at the
# window after a change, which no assertion replaces. Built and run exactly as
# bin/test runs the app tests.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
rm -rf "$ROOT/build/screens"
OMOTION_SCREENS="$ROOT/build/screens" exec "$ROOT/bin/test" app screens
